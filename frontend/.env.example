VITE_CATALOG_MODE=detal

# Runtime del contenedor Docker (TanStack Start). HOST/PORT también aplican en local.
# Para Docker: usar NODE_ENV=production en backend/.env y frontend/.env
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# API del backend (requerido para catálogo y checkout)
# Desarrollo local (pnpm dev): http://localhost:4000
# Frontend en Docker + backend en host (Windows/Mac): http://host.docker.internal:4000
# Stack completo con docker compose en la raíz: http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

VITE_WHATSAPP_NUMBER=573001234567

# Fallback del footer si GET /api/settings/store no está disponible
# En producción se configuran en Admin → Perfil
VITE_STORE_CONTACT_EMAIL=hola@stylos.co
VITE_STORE_CONTACT_INSTAGRAM=stylos.variedades
VITE_STORE_CONTACT_LOCATION=Colombia
