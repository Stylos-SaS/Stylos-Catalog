PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# PostgreSQL — Project Settings → Database → Connection string
# (NO son las API keys; necesitas la contraseña de la base de datos del proyecto)
#
# DATABASE_URL: Transaction pooler, puerto 6543 — la usa la API en runtime
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_DATABASE_URL: Direct connection, puerto 5432 — la usan las migraciones Prisma
DIRECT_DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

ADMIN_SEED_PASSWORD=admin123
WHATSAPP_NUMBER=573001234567
JWT_SECRET=change-me-in-production

# Supabase Storage — crear bucket público "product-images" en el dashboard
SUPABASE_STORAGE_BUCKET=product-images
# Luego: cd backend && docker compose up --build
